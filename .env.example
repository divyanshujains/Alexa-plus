# =================================================================
# LifePilot AI - Environment Configuration Example
# Copy this file to .env and supply your credentials
# DO NOT COMMIT YOUR REAL .ENV FILE TO VERSION CONTROL
# =================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lifepilot?retryWrites=true&w=majority

# Groq API Key (OpenAI-compatible LLM endpoint)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Base URL (Optional, defaults to https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq Model Name (Defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# MCP Server URL (Defaults to http://localhost:3000/mcp)
MCP_SERVER_URL=http://localhost:3000/mcp

# Server Port (Defaults to 3000)
PORT=3000

# Token Metrics Reporting in Terminal (true / false)
ENABLE_METRICS=true
